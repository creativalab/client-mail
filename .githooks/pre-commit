#!/usr/bin/env bash
# Ferrowl pre-commit hook: the same formatting and lint checks as CI.
#
#   Enable once per clone:   git config core.hooksPath .githooks
#   Skip in an emergency:    git commit --no-verify
set -euo pipefail

# GUI git clients and plain shells may not have cargo on PATH.
command -v cargo >/dev/null 2>&1 || . "$HOME/.cargo/env" 2>/dev/null || true

# Nothing to check if no Rust code or manifest is staged.
if ! git diff --cached --name-only | grep -qE '\.rs$|^Cargo\.(toml|lock)$|^rustfmt\.toml$'; then
    exit 0
fi

echo "pre-commit: cargo fmt --check"
if ! cargo fmt --all --check >/dev/null; then
    echo "✗ Code is not formatted. Run 'cargo fmt', stage the changes and commit again."
    exit 1
fi

echo "pre-commit: cargo clippy"
if ! cargo clippy --workspace --all-targets --quiet -- -D warnings; then
    echo "✗ Clippy found problems (see above). Fix them or run 'cargo clippy --fix'."
    exit 1
fi
