<?xml version="1.0" encoding="utf-8"?>
<!-- Mail, settings and keys stay on the device: nothing goes to cloud backup
     or device-to-device transfer (passwords are tied to this device's
     Keystore anyway). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
